end
local radius=info.radius * scale
cframes[index]=CFrame.new(info.spawn + Vector3.new(math.cos(info.angle) * radius,-3 + 6 * hs * phase,math.sin(info.angle) * radius)) * CFrame.Angles(0,0,math.pi / 2)
