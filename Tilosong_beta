local function formatDuration(totalSeconds)
local seconds=tonumber(totalSeconds)
if not seconds or seconds <= 0 then
return "--:--"
end
seconds=math.floor(seconds)
local hours=math.floor(seconds / 3600)
local minutes=math.floor((seconds % 3600) / 60)
local secs=seconds % 60
if hours > 0 then
return string.format("%d:%02d:%02d",hours,minutes,secs)
end
return string.format("%d:%02d",minutes,secs)
end
local PLAYLIST_FILE="TiloSong_playlist.json"
local playlist={}
local playlistListeners={}
local warnedNoFileSupport=false
local function canUseFiles()
return writefile ~= nil and readfile ~= nil and isfile ~= nil
end
local function savePlaylist()
if not canUseFiles() then
return false
end
local ok=pcall(function()
writefile(PLAYLIST_FILE,HttpService:JSONEncode(playlist))
end)
return ok
end
local function loadPlaylist()
if not canUseFiles() then
return
end
pcall(function()
if isfile(PLAYLIST_FILE) then
local data=HttpService:JSONDecode(readfile(PLAYLIST_FILE))
if type(data) == "table" then
playlist={}
for _,item in ipairs(data) do
if type(item) == "table" and item.id then
table.insert(playlist,{
id=tostring(item.id),
name=tostring(item.name or ("Трек " .. tostring(item.id))),
creator=tostring(item.creator or ""),
duration=tonumber(item.duration) or 0
})
end
end
end
end
end)
end
local function findPlaylistIndex(id)
local idText=tostring(id)
for index,item in ipairs(playlist) do
if item.id == idText then
return index
end
end
return nil
end
local function isInPlaylist(id)
return findPlaylistIndex(id) ~= nil
end
local function notifyPlaylistChanged()
for _,listener in ipairs(playlistListeners) do
pcall(listener)
end
end
local function togglePlaylistTrack(track)
if not track or not track.id then
return
end
local id=tostring(track.id)
local index=findPlaylistIndex(id)
if index then
table.remove(playlist,index)
else
table.insert(playlist,{
id=id,
name=track.name or ("Трек " .. id),
creator=track.creator or "",
duration=tonumber(track.duration) or 0
})
end
local saved=savePlaylist()
if not saved and not warnedNoFileSupport then
warnedNoFileSupport=true
showToast("⚠ Плейлист не сохранится после выхода: экзекьютор не даёт записывать файлы",4,false)
end
notifyPlaylistChanged()
end
