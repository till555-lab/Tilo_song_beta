local function checkTrackAlive(id)
local snd=_I("Sound")
snd.Volume=0
snd.SoundId="rbxassetid://" .. id
snd.Parent=ScreenGui
pcall(function()
ContentProvider:PreloadAsync({snd})
end)
local waited=0
while waited < 3 and not (snd.IsLoaded and snd.TimeLength > 0) do
task.wait(0.1)
waited=waited + 0.1
end
local alive=snd.IsLoaded and snd.TimeLength > 0
snd:Destroy()
return alive
end
local function runChecks(cards,token)
local nextIndex=1
local function worker()
while true do
local i=nextIndex
nextIndex=i + 1
local card=cards[i]
if not card or token ~= SS.token then
return
end
local alive=false
pcall(function()
alive=checkTrackAlive(card.id)
end)
card.setCheck(alive and "ok" or "bad")
end
end
for _=1,6 do
task.spawn(worker)
end
end
