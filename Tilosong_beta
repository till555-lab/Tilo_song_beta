end
local radius=(1.5 + 0.7 * phase) * scale
local a=info.angle
cframes[index]=CFrame.new(info.spawn + Vector3.new(math.cos(a) * radius,-3 + 6 * hs * phase,math.sin(a) * radius)) * CFrame.Angles(0,-(a + math.pi / 2),0)
