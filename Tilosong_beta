showToast("🎉 «" .. a.pet.name .. "» достиг уровня " .. lvl .. "!",4,false)
end
a.lvLbl.Text="Ур. " .. lvl .. " • " .. math.floor(frac * 100) .. "%"
a.fill.Size=_U(frac,0,1,0)
end
end
