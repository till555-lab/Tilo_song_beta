local function poseDog(d,root,pose)
local S=SCALE
local P=d.p
local sp=d.spec
local parts,cfs={},{}
local function put(part,cf)
parts[#parts + 1]=part
cfs[#cfs + 1]=cf
end
put(P.body,root)
local hipY=-0.4 * S
local legHalf=-0.45 * S
local hx=(sp.b.bw / 2 - 0.2) * S
local hzF=-(sp.b.bl / 2 - 0.3) * S
local hzB=(sp.b.bl / 2 - 0.3) * S
put(P.fl,root * CFrame.new(-hx,hipY,hzF) * CFrame.Angles(pose.fl,0,0) * CFrame.new(0,legHalf,0))
put(P.fr,root * CFrame.new(hx,hipY,hzF) * CFrame.Angles(pose.fr,0,0) * CFrame.new(0,legHalf,0))
put(P.bl,root * CFrame.new(-hx,hipY,hzB) * CFrame.Angles(pose.bl,0,0) * CFrame.new(0,legHalf,0))
put(P.br,root * CFrame.new(hx,hipY,hzB) * CFrame.Angles(pose.br,0,0) * CFrame.new(0,legHalf,0))
local hc=root * CFrame.new(0,0.35 * S,-(sp.b.bl / 2) * S) * CFrame.Angles(pose.head,0,pose.roll or 0) * CFrame.new(0,0.2 * S,-0.5 * S)
put(P.head,hc)
put(P.snout,hc * CFrame.new(0,-0.15 * S,-(0.475 + sp.sn.l / 2) * S))
put(P.nose,hc * CFrame.new(0,-0.05 * S,-(0.475 + sp.sn.l + 0.015) * S))
local ex=sp.e.x * S
put(P.eyeL,hc * CFrame.new(-ex,0.15 * S,-0.46 * S))
put(P.eyeR,hc * CFrame.new(ex,0.15 * S,-0.46 * S))
put(P.pupL,hc * CFrame.new(-ex,0.14 * S,-0.5 * S))
put(P.pupR,hc * CFrame.new(ex,0.14 * S,-0.5 * S))
local r=sp.r
local eL=hc * CFrame.new(-r.x * S,r.y * S,0.05 * S) * CFrame.Angles(0,0,r.roll)
local eR=hc * CFrame.new(r.x * S,r.y * S,0.05 * S) * CFrame.Angles(0,0,-r.roll)
put(P.earL,eL)
put(P.earR,eR)
local inOff=CFrame.new(0,-r.h * 0.1 * S,-(r.t / 2 + 0.01) * S)
put(P.earInL,eL * inOff)
put(P.earInR,eR * inOff)
put(P.tail,root * CFrame.new(0,0.3 * S,(sp.b.bl / 2) * S) * CFrame.Angles(pose.tail,pose.wag,0) * CFrame.new(0,0.2 * S,sp.t.l * 0.43 * S))
if d.eo ~= pose.eyes then
d.eo=pose.eyes
local h=pose.eyes and sp.e.h or 0.05
P.eyeL.Size=Vector3.new(sp.e.w,h,0.06) * S
P.eyeR.Size=Vector3.new(sp.e.w,h,0.06) * S
P.pupL.Transparency=pose.eyes and 0 or 1
P.pupR.Transparency=pose.eyes and 0 or 1
end
applyCF(parts,cfs)
end
local function angDiff(a,b)
return (b - a + math.pi) % (2 * math.pi) - math.pi
end
local function stepPet(dt)
local a=active
if not a then
return
end
local char=LocalPlayer.Character
local root=char and char:FindFirstChild("HumanoidRootPart")
local hum=char and char:FindFirstChildOfClass("Humanoid")
if not root or not hum then
return
end
if a.char ~= char then
a.char=char
a.params.FilterDescendantsInstances={char,a.dog.model,workspace.CurrentCamera}
end
local S=SCALE
local now=os.clock()
a.pet.play=a.pet.play + dt
local vel=root.AssemblyLinearVelocity
local pSpeed=Vector3.new(vel.X,0,vel.Z).Magnitude
if pSpeed > 2 then
a.heading=a.heading + angDiff(a.heading,math.atan2(-vel.X,-vel.Z)) * math.min(1,dt * 3)
end
local hs=hum:GetState()
local dead=hum.Health <= 0 or hs == Enum.HumanoidStateType.Dead
local swimming=hs == Enum.HumanoidStateType.Swimming
local inAir=(hs == Enum.HumanoidStateType.Jumping or hs == Enum.HumanoidStateType.Freefall) and not swimming
if inAir then
a.airFor=a.airFor + dt
else
a.airFor=0
a.spun=false
a.spinLeft=0
a.peakH=0
end
local airMode=a.airFor > 0.12
local tLand=0
if airMode then
local ray=workspace:Raycast(root.Position,Vector3.new(0,-600,0),a.params)
local h=ray and math.max(0,root.Position.Y - ray.Position.Y - 3) or 0
a.peakH=math.max(a.peakH,h)
local vy=-vel.Y
tLand=(vy + math.sqrt(vy * vy + 2 * workspace.Gravity * h)) / workspace.Gravity
end
local off=SIDE[sett.side] or SIDE.br
local goal
if dead then
goal=root.Position + Vector3.new(1.8,0,1.2)
else
goal=root.Position + CFrame.Angles(0,a.heading,0):VectorToWorldSpace(off)
end
local flat=Vector3.new(goal.X - a.pos.X,0,goal.Z - a.pos.Z)
local dist=flat.Magnitude
if dist > 80 then
a.pos=Vector3.new(goal.X,a.pos.Y,goal.Z)
flat=Vector3.new(0,0,0)
dist=0
a.moving=false
end
local onD=pSpeed > 1 and 1.4 or 3.2
local offD=pSpeed > 1 and 0.7 or 1.4
if dist > onD then
a.moving=true
elseif dist < offD then
a.moving=false
end
local v=0
if a.moving and dist > 0.05 then
v=math.min(dist * 4 + 3,28)
a.pos=a.pos + flat.Unit * math.min(v * dt,dist)
if not a.spinNow then
local want=math.atan2(-flat.X,-flat.Z)
a.yaw=a.yaw + angDiff(a.yaw,want) * math.min(1,dt * 10)
end
elseif not a.spinNow then
local toP=Vector3.new(root.Position.X - a.pos.X,0,root.Position.Z - a.pos.Z)
if toP.Magnitude > 0.5 then
local want=math.atan2(-toP.X,-toP.Z)
a.yaw=a.yaw + angDiff(a.yaw,want) * math.min(1,dt * 4)
end
end
local resting=(not a.moving) and pSpeed < 1 and not swimming and not airMode and not dead
if resting then
a.idleT=a.idleT + dt
else
a.idleT=0
end
a.phase=a.phase + v * dt * 2.4
local state="stand"
if dead then
state="sad"
elseif swimming then
state="swim"
elseif airMode then
state="air"
elseif v > 0.3 then
state=(v > 14) and "run" or "walk"
elseif a.idleT > 120 then
state="sleep"
elseif a.idleT > 60 then
state="lie"
elseif a.idleT > 10 then
state="sit"
end
if a.state ~= state then
a.state=state
a.look=0
a.wake=math.random(10,60)
end
if state == "sleep" then
a.wake=a.wake - dt
if a.look > 0 then
a.look=a.look - dt
elseif a.wake <= 0 then
a.look=3
a.wake=math.random(10,60)
end
end
local tgt={fl=0,fr=0,bl=0,br=0,head=0,tail=-0.5,bodyY=1.3 * S,pitch=0,roll=0}
local wag=0
local eyes=true
local hop=0
a.spinNow=false
if state == "walk" or state == "run" then
local amp=(state == "run") and 0.95 or 0.7
local sw=math.sin(a.phase) * amp
tgt.fl=sw
tgt.fr=-sw
tgt.bl=-sw
tgt.br=sw
tgt.head=math.sin(a.phase * 2) * 0.05
wag=math.sin(now * 8) * 0.4
if state == "run" then
hop=math.abs(math.sin(a.phase)) * 0.22 * S
tgt.pitch=-0.08
end
elseif state == "swim" then
tgt.fl=math.sin(now * 9) * 0.9
tgt.fr=math.sin(now * 9 + 2) * 0.9
tgt.bl=math.sin(now * 9 + 1) * 0.9
tgt.br=math.sin(now * 9 + 3) * 0.9
tgt.head=0.3
tgt.bodyY=0.4 * S
wag=math.sin(now * 3) * 0.3
elseif state == "air" then
local spinning=false
if tLand > 1.2 then
spinning=true
a.spinRate=14
elseif vel.Y < -5 and a.peakH > 8 and not a.spun then
a.spun=true
a.spinLeft=0.5
end
if a.spinLeft > 0 then
a.spinLeft=a.spinLeft - dt
spinning=true
a.spinRate=12.6
end
if spinning then
a.spinNow=true
a.yaw=a.yaw + a.spinRate * dt
tgt.fl=0.8
tgt.fr=0.8
tgt.bl=0.8
tgt.br=0.8
elseif vel.Y > 5 and a.airFor < 0.5 then
tgt.pitch=0.35
tgt.fl=0.8
tgt.fr=0.8
tgt.bl=-0.9
tgt.br=-0.9
tgt.head=-0.3
else
tgt.fl=0.55
tgt.fr=0.55
tgt.bl=-0.55
tgt.br=-0.55
tgt.head=-0.15
end
wag=math.sin(now * 6) * 0.3
elseif state == "sad" then
tgt.pitch=0.4
tgt.bodyY=1.0 * S
tgt.fl=-0.4
tgt.fr=-0.4
tgt.bl=1.4
tgt.br=1.4
tgt.head=-0.7
tgt.tail=-1.3
eyes=false
elseif state == "sit" then
tgt.pitch=0.6
tgt.bodyY=1.0 * S
tgt.fl=-0.6
tgt.fr=-0.6
tgt.bl=1.4
tgt.br=1.4
tgt.head=-0.5
wag=math.sin(now * 3) * 0.3
elseif state == "lie" or state == "sleep" then
tgt.bodyY=0.55 * S
tgt.fl=1.4
tgt.fr=1.4
tgt.bl=1.4
tgt.br=1.4
tgt.head=-0.15
tgt.tail=-0.2
wag=math.sin(now * 2) * 0.2
if state == "sleep" then
tgt.head=-0.4
if a.look > 0 then
tgt.head=0.1
else
eyes=false
end
end
else
wag=math.sin(now * 3) * 0.35
tgt.bodyY=1.3 * S + math.sin(now * 2) * 0.015 * S
if a.idleT > 4 and now > a.nextScr and a.scr < now then
a.scr=now + 1.8
a.nextScr=now + 10 + math.random() * 10
end
if a.scr > now then
tgt.bl=1.25 + math.sin(now * 20) * 0.45
tgt.head=0.1
tgt.roll=0.4
wag=0
end
end
if a.sT and now - a.sT < 1.2 then
local p=(now - a.sT) / 1.2
hop=hop + math.sin(p * math.pi) * 1 * S
wag=math.sin(now * 14) * 0.6
tgt.head=0.25
a.idleT=0
end
if now >= a.nextBlink then
a.blinkUntil=now + 0.12
a.nextBlink=now + 3 + math.random() * 3
end
if now < a.blinkUntil then
eyes=false
end
local f=math.min(1,dt * 9)
for key,value in pairs(tgt) do
a.cur[key]=a.cur[key] + (value - a.cur[key]) * f
end
local gy=a.gy
if state == "swim" then
gy=root.Position.Y - 1.25
elseif state == "air" then
gy=root.Position.Y - 3
else
local hit=workspace:Raycast(a.pos + Vector3.new(0,5,0),Vector3.new(0,-16,0),a.params)
if hit then
gy=hit.Position.Y
end
end
a.gy=a.gy + (gy - a.gy) * math.min(1,dt * 14)
local c=a.cur
local pz=a.pz
pz.fl=c.fl
pz.fr=c.fr
pz.bl=c.bl
pz.br=c.br
pz.head=c.head
pz.roll=c.roll
pz.tail=c.tail
pz.wag=wag
pz.eyes=eyes
local rootCF=CFrame.new(a.pos.X,a.gy + c.bodyY + hop,a.pos.Z) * CFrame.Angles(0,a.yaw,0) * CFrame.Angles(c.pitch,0,0)
poseDog(a.dog,rootCF,pz)
local sleeping=(state == "sleep" and a.look <= 0)
local sad=state == "sad"
local wantTxt=sad and "😢" or "Z"
if a.zlab.Text ~= wantTxt then
a.zlab.Text=wantTxt
end
a.zbb.Enabled=sleeping or sad
if sleeping then
a.zbb.StudsOffset=Vector3.new(0.2,1.2 + (now % 2) * 0.35,0)
a.zlab.TextTransparency=(now % 2) / 2
elseif sad then
a.zbb.StudsOffset=Vector3.new(0.2,1.3 + math.sin(now * 3) * 0.1,0)
a.zlab.TextTransparency=0
end
a.lt=a.lt + dt
if a.lt > 0.5 then
a.lt=0
local lvl,frac=levelInfo(a.pet.play)
if lvl > a.lastLvl then
