qs.grad=function(n)
local points={}
if n <= 10 then
for i=0,n - 1 do
local value=(n - 1 - i) / (n - 1)
local t1=(i + 1) / n - 0.0005
if i == n - 1 then
t1=1
end
points[#points + 1]=NumberSequenceKeypoint.new(i / n,value)
points[#points + 1]=NumberSequenceKeypoint.new(t1,value)
end
else
points={NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}
end
local seq=NumberSequence.new(points)
for _,info in ipairs(auraParts) do
if info.grads then
for _,gr in ipairs(info.grads) do
gr.Transparency=seq
end
end
end
end
