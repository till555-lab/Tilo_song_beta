local haloParts={}
local builtKind=0
local haloSpinning=false
local SEGMENTS=20
local lastScale=nil
local function clearHalo()
for _,info in ipairs(haloParts) do
info.part:Destroy()
end
haloParts={}
builtKind=0
end
local function makePart(size)
local part=_I("Part")
part.Anchored=true
part.CanCollide=false
part.CanQuery=false
part.CanTouch=false
part.CastShadow=false
part.Size=size
part.Parent=workspace.CurrentCamera
return part
end
local function buildHalo(kind)
clearHalo()
local rings,extras,spinning,alpha=kindDef(kind)
haloSpinning=spinning
for _,ring in ipairs(rings) do
for i=1,SEGMENTS do
table.insert(haloParts,{part=makePart(Vector3.new(0.1,0.1,0.1)),ring=ring,angle=(i - 1) * 2 * math.pi / SEGMENTS,alpha=alpha})
end
end
for _,extra in ipairs(extras) do
table.insert(haloParts,{part=makePart(extra.size),extra=extra,alpha=alpha})
end
builtKind=kind
lastScale=nil
end
RunService.RenderStepped:Connect(function()
if cfg.kind == 0 then
if builtKind ~= 0 then
clearHalo()
end
return
end
local character=LocalPlayer.Character
local headPart=character and character:FindFirstChild("Head")
if not headPart then
return
end
if builtKind ~= cfg.kind or (haloParts[1] and not haloParts[1].part.Parent) then
buildHalo(cfg.kind)
end
local t=os.clock()
local bob,extraSpin,sway,pulse=0,0,0,1
local anim=cfg.anim
if anim == 2 then
bob=0.25 * math.sin(t * 2)
elseif anim == 3 then
bob=0.75 * math.sin(t * 2)
elseif anim == 4 then
extraSpin=(t * 90) % 360
elseif anim == 5 then
sway=12 * math.sin(t * 2)
elseif anim == 6 then
pulse=1 + 0.12 * math.sin(t * 4)
end
if haloSpinning then
extraSpin=extraSpin + (t * 120) % 360
end
local scale=(cfg.size / 100) * pulse
local base=headPart.CFrame * CFrame.new(cfg.side / 10,cfg.height / 10 + bob,-cfg.forward / 10) * CFrame.Angles(math.rad(cfg.tiltX),math.rad(cfg.spin + extraSpin),math.rad(cfg.tiltZ + sway))
local color=haloColors[cfg.color] or haloColors[1]
if cfg.glow == 3 then
color=Color3.fromHSV((t * 0.25) % 1,0.75,1)
end
local material=Enum.Material.SmoothPlastic
if cfg.glow ~= 1 then
material=Enum.Material.Neon
end
local parts,cframes={},{}
for index,info in ipairs(haloParts) do
local part=info.part
if info.ring then
local ring=info.ring
local ringCF=base * CFrame.new(0,ring.y * scale,0) * CFrame.Angles(0,0,math.rad(ring.tilt))
local radius=ring.r * scale
local a=info.angle
cframes[index]=ringCF * CFrame.new(math.cos(a) * radius,0,math.sin(a) * radius) * CFrame.Angles(0,-a,0)
if lastScale ~= scale then
part.Size=Vector3.new(ring.th * scale,ring.th * scale,2 * math.pi * radius / SEGMENTS * 1.15)
end
else
local extra=info.extra
cframes[index]=base * CFrame.new(extra.pos * scale) * CFrame.Angles(math.rad(extra.rot.X),math.rad(extra.rot.Y),math.rad(extra.rot.Z))
if lastScale ~= scale then
part.Size=extra.size * scale
end
end
parts[index]=part
if part.Color ~= color then
part.Color=color
end
if part.Material ~= material then
part.Material=material
end
if part.Transparency ~= info.alpha then
part.Transparency=info.alpha
end
end
lastScale=scale
local moved=pcall(function()
workspace:BulkMoveTo(parts,cframes,Enum.BulkMoveMode.FireCFrameChanged)
end)
if not moved then
for index,part in ipairs(parts) do
part.CFrame=cframes[index]
end
end
end)
