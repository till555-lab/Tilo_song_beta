end
local edge=math.abs(u - 0.5) * 2
alpha=0.1 + 0.9 * edge * edge
elseif mode == "colg" then
local total=10 * hs
cframes[index]=CFrame.new(fo + Vector3.new(math.cos(info.a) * radiusCol,-4.5 + total / 2,math.sin(info.a) * radiusCol)) * info.rot
