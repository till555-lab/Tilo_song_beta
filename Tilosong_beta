local function lookOf(p)
return {p.atmo[1],p.atmo[2],p.atmo[3],p.atmo[4],p.atmo[5],p.amb,p.tint or whiteTint,p.bright or 0,p.sat or 0,fogColors[p.id]}
end
local function mix(a,b,t)
if typeof(a) == "Color3" then
return a:Lerp(b,t)
end
return a + (b - a) * t
end
local function sampleLook(hour)
local k1,k2=cycleKeys[1],cycleKeys[2]
for i=1,#cycleKeys - 1 do
if hour >= cycleKeys[i].h and hour < cycleKeys[i + 1].h then
k1,k2=cycleKeys[i],cycleKeys[i + 1]
break
end
end
local t=math.clamp((hour - k1.h) / (k2.h - k1.h),0,1)
local a,b=lookOf(skyById[k1.p]),lookOf(skyById[k2.p])
local v={}
for i=1,10 do
v[i]=mix(a[i],b[i],t)
end
return v
end
local function blendAt(hour)
local atmo=skyState.atmo
if not atmo then
return
end
local v=sampleLook(hour)
atmo.Color,atmo.Decay,atmo.Density,atmo.Haze,atmo.Glare=v[1],v[2],v[3],v[4],v[5]
skyState.baseDensity=v[3]
skyState.baseHaze=v[4]
Lighting.OutdoorAmbient=v[6]
if not skyState.cc then
skyState.cc=_I("ColorCorrectionEffect")
skyState.cc.Parent=Lighting
end
skyState.cc.TintColor=v[7]
skyState.cc.Brightness=v[8]
skyState.cc.Saturation=v[9]
end
