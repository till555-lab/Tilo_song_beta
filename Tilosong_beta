positioned=true
local centerX=ScreenGui.AbsoluteSize.X / 2
if centerX - 505 >= 0 then
settingsFrame.Position=_U(0.5,-505,0.15,0)
end
end
settingsFrame.Visible=not settingsFrame.Visible
palettePopup.Visible=false
end)
local wasOpen=false
MainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
if not MainFrame.Visible then
wasOpen=settingsFrame.Visible
settingsFrame.Visible=false
palettePopup.Visible=false
elseif wasOpen then
settingsFrame.Visible=true
wasOpen=false
end
end)
loadTheme()
for _,setting in ipairs(allSettings) do
local rgb=themeData[setting.key]
if type(rgb) == "table" and #rgb == 3 then
setting.apply(_C(rgb[1],rgb[2],rgb[3]))
end
end
if themeData[CLOCK_KEY] == true then
setClockExtended(true)
end
if themeData.hide_dead == true then
setHideDead(true)
end
if type(themeData.tab_pos) == "number" then
setTabPos(themeData.tab_pos)
end
if type(themeData.tab_w) == "number" then
setTabW(themeData.tab_w)
end
if type(themeData.tab_h) == "number" then
setTabH(themeData.tab_h)
end
showSettingsPage("colors")
end)
if not okSettings then
warn("Tilo Song: окно настроек не создалось: " .. tostring(errSettings))
end
end
