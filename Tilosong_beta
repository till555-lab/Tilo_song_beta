local function loadTrackInternal(idText,knownName,knownCreator)
local digits=string.match(tostring(idText),"%d+")
local id=digits and tonumber(digits)
if not id then
setPlayerStatus("❌ Введите ID песни (только цифры)",COLOR_ERROR)
return false
end
trackLoaded=false
currentTrackId=nil
currentTrackInfo=nil
localSound:Stop()
refreshTrackCards()
updatePlayerStar()
setPlayerStatus("⏳ Загрузка...",COLOR_YELLOW)
local trackName=knownName
local creatorName=knownCreator
if not trackName or not creatorName or creatorName == "" then
local okInfo,info=pcall(function()
return MarketplaceService:GetProductInfo(id)
end)
if okInfo and info then
trackName=trackName or info.Name
if (not creatorName or creatorName == "") and info.Creator then
creatorName=info.Creator.Name
end
end
end
localSound.SoundId="rbxassetid://" .. tostring(id)
pcall(function()
ContentProvider:PreloadAsync({localSound})
end)
local waited=0
while waited < 4 and not (localSound.IsLoaded and localSound.TimeLength > 0) do
task.wait(0.1)
waited=waited + 0.1
end
if localSound.IsLoaded and localSound.TimeLength > 0 then
trackLoaded=true
currentTrackId=tostring(id)
currentTrackInfo={
id=tostring(id),
name=trackName or ("Трек " .. tostring(id)),
creator=creatorName or "",
duration=localSound.TimeLength
}
applyLoopFlag()
setPlayerStatus("🎵 " .. currentTrackInfo.name .. "  (" .. formatDuration(localSound.TimeLength) .. ")",COLOR_WHITE)
refreshPlayButton()
updatePlayerStar()
refreshTrackCards()
return true
end
setPlayerStatus("❌ Песня не найдена или недоступна",COLOR_ERROR)
return false
end
