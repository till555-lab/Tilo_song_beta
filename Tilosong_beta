local function importText(text)
local raw=((text or ""):gsub("^%s+",""))
raw=(raw:gsub("%s+$",""))
if raw == "" then
popup("Ничего не введено")
return
end
if raw:sub(1,1) ~= "{" then
if not filesOk then
popup("Файлы недоступны в этом executor, вставьте код питомца")
return
end
local name=raw
local okF,exists=pcall(isfile,name)
if not (okF and exists) then
name=raw .. ".txt"
end
local ok,content=pcall(readfile,name)
if not ok or type(content) ~= "string" then
popup("Файл не найден в папке workspace")
return
end
raw=content
end
local ok,data=pcall(function()
return HttpService:JSONDecode(raw)
end)
if not ok or type(data) ~= "table" then
popup("Не удалось прочитать данные питомца")
return
end
local list={}
if type(data.pets) == "table" then
list=data.pets
elseif type(data.pet) == "table" then
list={data.pet}
elseif data.name then
list={data}
end
local added=0
for _,p in ipairs(list) do
if #pets >= MAXPETS then
break
end
local clean=cleanPet(p)
if clean then
table.insert(pets,clean)
added=added + 1
selectedId=clean.id
end
end
saveAll()
refreshList()
if added > 0 then
popup("Импортировано питомцев: " .. added)
else
popup("Питомцы не найдены в этих данных")
end
end
