local function updateWallFade(cam,char,targetPos)
local origin=cam.CFrame.Position
local direction=targetPos - origin
if direction.Magnitude < 1 then
return
end
local excludeList={char,cam}
local params=RaycastParams.new()
params.FilterType=Enum.RaycastFilterType.Exclude
local current={}
for _=1,8 do
params.FilterDescendantsInstances=excludeList
local result=workspace:Raycast(origin,direction,params)
if not result then
break
end
local hitPart=result.Instance
table.insert(excludeList,hitPart)
if hitPart:IsA("BasePart") and not hitPart:IsA("Terrain") and hitPart.Transparency < 0.9 then
if fadedParts[hitPart] == nil then
fadedParts[hitPart]=hitPart.LocalTransparencyModifier
end
hitPart.LocalTransparencyModifier=0.9
current[hitPart]=true
end
end
for part,original in pairs(fadedParts) do
if not current[part] then
if part.Parent then
part.LocalTransparencyModifier=original
end
fadedParts[part]=nil
end
end
end
