end
end
skyState.fogAtmo.Parent=Lighting
end
skyState.fogAtmo.Color=fogLook
skyState.fogAtmo.Decay=fogLook
skyState.fogAtmo.Density=power
skyState.fogAtmo.Haze=10 * power
end
elseif fogOrig then
Lighting.FogStart,Lighting.FogEnd,Lighting.FogColor=fogOrig[1],fogOrig[2],fogOrig[3]
fogOrig=nil
if skyState.fogAtmo then
skyState.fogAtmo:Destroy()
