cframes[index]=CFrame.new(fo + Vector3.new(math.cos(info.a) * radiusCol,y,math.sin(info.a) * radiusCol)) * info.rot
local sizeKey=scale * 100 + hs * 31 + qs.ar + segCount * 0.37
if info.sk ~= sizeKey then
info.sk=sizeKey
part.Size=Vector3.new(math.max(0.5,2 * math.pi * radiusCol / qs.ar * 1.12),segH + 0.02,0.06)
end
alpha=(info.j - 1) / math.max(1,segCount - 1)
end
parts[index]=part
if apply then
part.Color=color
part.Material=material
end
if not info.al or math.abs(info.al - alpha) > 0.02 then
