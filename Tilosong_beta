Lighting.ClockTime=cycleHour % 24
blendAt(cycleHour)
end
if fogStrength > 0 then
if not fogOrig then
fogOrig={Lighting.FogStart,Lighting.FogEnd,Lighting.FogColor}
end
local hr=Lighting.ClockTime
if hr < 6.4 then
hr=hr + 24
end
local k=1 - fogStrength / 100
local fogLook=sampleLook(hr)[10]
Lighting.FogStart=0
Lighting.FogEnd=1500 * k * k + 40
Lighting.FogColor=fogLook
local power=fogStrength / 100
if skyState.atmo then
if skyState.fogAtmo then
skyState.fogAtmo:Destroy()
skyState.fogAtmo=nil
for _,saved in ipairs(fogStash) do
