local function pickRandomTrack()
local found=nil
pcall(function()
local keyword=randomKeywords[math.random(1,#randomKeywords)]
local searchParams=_I("AudioSearchParams")
searchParams.SearchKeyword=keyword
searchParams.MinDuration=30
local pages=AssetService:SearchAudioAsync(searchParams)
local advanceCount=math.random(0,2)
for _=1,advanceCount do
if pages.IsFinished then break end
pages:AdvanceToNextPageAsync()
end
local page=pages:GetCurrentPage()
if #page > 0 then
found=page[math.random(1,#page)]
end
end)
return found
end
