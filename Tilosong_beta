local function playPlaylistFrom(startIndex)
if isBusy then return end
if #playlist == 0 then
setPlayerStatus("📋 Плейлист пуст. Нажмите ☆ на песне, чтобы добавить",COLOR_YELLOW)
return
end
playlistRunToken=playlistRunToken + 1
local myToken=playlistRunToken
setPlaylistActive(true)
local index=startIndex or 1
local failuresInRow=0
local finished=false
while playlistActive and myToken == playlistRunToken do
if index > #playlist then
if repeatMode == "loop" then
index=1
else
finished=true
break
end
end
local item=playlist[index]
if not item then
finished=true
break
end
isBusy=true
local okCall,loaded=pcall(loadTrackInternal,item.id,item.name,item.creator)
isBusy=false
if not (playlistActive and myToken == playlistRunToken) then
return
end
if okCall and loaded then
failuresInRow=0
localSound:Play()
task.wait(0.5)
while playlistActive and myToken == playlistRunToken do
if not localSound.IsPlaying and not localSound.IsPaused then
break
end
task.wait(0.25)
end
else
failuresInRow=failuresInRow + 1
if failuresInRow >= #playlist then
setPlayerStatus("❌ Ни одна песня плейлиста не загрузилась",COLOR_ERROR)
break
end
end
index=index + 1
end
if myToken == playlistRunToken then
setPlaylistActive(false)
if finished then
setPlayerStatus("📋 Плейлист закончился",COLOR_YELLOW)
end
end
end
PlayAllBtn.MouseButton1Click:Connect(function()
if playlistActive then
stopPlaylist()
localSound:Stop()
setPlayerStatus("⏹ Плейлист остановлен",COLOR_YELLOW)
else
playPlaylistFrom(1)
end
end)
